# Template only — NEVER put real keys in this file. It is committed and
# shared with the team; .gitignore excludes .env, not .env.example.
# Real values go in .env:  cp .env.example .env

# --- Stage 1: Listen (Speechmatics) ---
SPEECHMATICS_API_KEY=
SPEECHMATICS_RT_URL=wss://eu.rt.speechmatics.com/v2
# Speechmatics regions: eu.rt.speechmatics.com | us.rt.speechmatics.com

# --- Stages 2 + 4: Understand and Judge (AI/ML API) ---
# The hackathon grants ONE provider key — AI/ML API or Featherless, not both.
# This build runs both LLM stages on AI/ML API. There is no Featherless
# dependency anywhere in the code.
AIML_API_KEY=
AIML_API_BASE=https://api.aimlapi.com/v1
# MUST be a non-reasoning model. Reasoning tokens count against max_tokens, so
# a thinking model burns the whole budget on hidden reasoning and returns no
# content at all — extraction then silently yields zero fields. Measured:
# kimi-k2.6 = 90s+ timeout with no output; deepseek/deepseek-chat = 2.9s, clean.
AIML_KIMI_MODEL=deepseek/deepseek-chat
# Judgment model. Blank = reuse AIML_KIMI_MODEL, which is the id you'll have
# already confirmed works. Point it at any open-weight model in the AI/ML
# catalog to keep the brief's "auditable / self-hostable weights" compliance
# argument intact — that's a property of the model, not of who hosts it.
AIML_JUDGE_MODEL=

# --- Stage 3: Go look (Bright Data) ---
BRIGHTDATA_API_KEY=
BRIGHTDATA_API_BASE=https://api.brightdata.com
# Keep true until the four lookups in bright_data_client.py are actually
# written — a key alone doesn't mean there's an implementation to call, and
# with this false the unimplemented lookups raise NotImplementedError. Also a
# free way to develop the rest of the pipeline without spending Bright Data
# credits.
BRIGHTDATA_USE_STUB=true

# --- Storage (Supabase — Burhan's existing project) ---
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# --- Credit control (Stage 2 throttle) ---
# Stage 2 is the only paid call that repeats during a call. Untuned, a
# 4-minute call fires one extraction per final transcript turn (~40) over an
# ever-growing transcript. These cut that to a handful with no visible
# difference to the frontend. Defaults are demo-safe; raise the interval
# while iterating on other stages to spend even less.
EXTRACTION_MIN_NEW_CHARS=180    # need this much new speech before re-extracting
EXTRACTION_MIN_INTERVAL_S=8     # ...and this many seconds since the last one
EXTRACTION_MAX_CALLS=12         # hard ceiling per call, whatever else happens
